{
  "name": "pi-switchyard",
  "version": "0.1.0",
  "type": "module",
  "description": "Jev-powered logical-thread and model-tier router for Pi",
  "license": "MIT",
  "author": "EngoDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EngoDev/pi-switchyard.git"
  },
  "homepage": "https://github.com/EngoDev/pi-switchyard#readme",
  "bugs": {
    "url": "https://github.com/EngoDev/pi-switchyard/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jev",
    "llm",
    "model-routing",
    "context-management"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "check:package-load": "pi -ne -e . -p --no-session '/switchyard show'",
    "check:global-load": "cd /tmp && pi -p --no-session '/switchyard show'",
    "evaluate:live": "tsx scripts/evaluate-live.ts",
    "prepublishOnly": "pnpm check && pnpm check:package-load"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typebox": "^1.0.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1",
    "typebox": ">=1.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
